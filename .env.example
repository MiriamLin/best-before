# The Graph gateway key. Copy this file to .env and keep .env uncommitted.
GRAPH_API_KEY=

# Hedera testnet service account. Private keys must be DER-encoded ECDSA strings.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Hedera testnet buyer account used by the CLI and MCP client.
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=

# An existing HCS topic created without an admin key.
HCS_TOPIC_ID=

# Optional: defaults to http://localhost:3000.
BEST_BEFORE_URL=http://localhost:3000
